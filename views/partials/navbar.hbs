</style>

<nav class="nav-extended custom-navbar">
  <div class="nav-wrapper">
    <a href="#" class="brand-logo left">
      <img src="Logo.png" alt="Логотип" class="logo-img">
      <span class="hide-on-med-and-down">B2B Flow</span>
