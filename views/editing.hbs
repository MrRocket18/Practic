{{!-- <!Страница редактирования заявки> --}}

<div class="edit-container">
  <div class="row">
    <div class="col s12 m6 offset-m3">
      <div class="card">
        <div class="card-content">
          <h1 class="edit-title">Редактирование заявки</h1>
          
          <form class="edit-form" action="/edit" method="POST">
            <div class="input-field">
              <input id="title" name="title" type="text" class="validate">
              <label for="title">Название</label>
            </div>
            
            <div class="input-field">
              <input id="quantity" name="quantity" type="number" class="validate" min="1" required>
              <label for="quantity">Количество</label>
            </div>
            
            <div class="input-field">
              <input id="price" name="price" type="number" class="validate" min="0" step="0.01">
              <label for="price">Цена</label>
            </div>
            
            <div class="input-field">
              <input id="link" name="link" type="url" class="validate">
              <label for="link">Ссылка</label>
            </div>
            
            <div class="input-field">
              <input id="date" name="date" type="text" class="datepicker">
              <label for="date">Дата</label>
            </div>
            
            <div class="input-field">
              <textarea id="comment" name="comment" class="materialize-textarea"></textarea>
              <label for="comment">Комментарий</label>
            </div>
            
            <button class="btn waves-effect waves-light submit-btn" type="submit">
              СОХРАНИТЬ ИЗМЕНЕНИЯ
              <i class="material-icons right">save</i>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const dateElems = document.querySelectorAll('.datepicker');
    M.Datepicker.init(dateElems, {
      format: 'dd.mm.yyyy',
      autoClose: true,
      i18n: {
        cancel: 'Отмена',
        clear: 'Очистить',
        done: 'Выбрать',
        months: ['Январь', 'Февраль', 'Март', 'Апрель', 'Май', 'Июнь', 'Июль', 'Август', 'Сентябрь', 'Октябрь', 'Ноябрь', 'Декабрь'],
        monthsShort: ['Янв', 'Фев', 'Мар', 'Апр', 'Май', 'Июн', 'Июл', 'Авг', 'Сен', 'Окт', 'Ноя', 'Дек'],
        weekdays: ['Воскресенье', 'Понедельник', 'Вторник', 'Среда', 'Четверг', 'Пятница', 'Суббота'],
        weekdaysShort: ['Вс', 'Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб'],
        weekdaysAbbrev: ['В', 'П', 'В', 'С', 'Ч', 'П', 'С']
      }
    });

    // Инициализация textarea для комментариев
    M.textareaAutoResize($('#comment'));
  });
</script>