<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Авторизация</title>
  <!-- Подключаем Materialize CSS -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
  <!-- Подключаем Material Icons -->
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <style>
   
  </style>
</head>
<body>
  <div class="auth-container">
    <div class="row">
      <div class="col s12 m12 l10 offset-l1">
        <div class="card auth-card">
          <div class="card-content">
            <span class="card-title auth-title">Авторизация</span>
            
            <form id="auth-form" method="POST">
              <div class="input-field">
                <input id="email" type="text" class="validate" required>
                <label for="email">Логин</label>
              </div>
              
              <div class="input-field">
                <input id="password" type="password" class="validate" required>
                <label for="password">Пароль</label>
              </div>
              
              <p class="remember-me">
                <label>
                  <input type="checkbox" class="filled-in" checked="checked" />
                  <span>Запомнить меня</span>
                </label>
              </p>
              
              <button id="loginform" class="btn waves-effect waves-light auth-submit" type="submit">
                ВОЙТИ
                <i class="material-icons right">arrow_forward</i>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  